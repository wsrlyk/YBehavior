{
  "_notes": [
    "Create a new theme object, inherit from default, then override only the colors you want to change.",
    "Optional: set baseTheme to inherit from another theme, then only override changed fields.",
    "currentTheme is selected from editor_meta.local.json (currentTheme or uiMeta.currentTheme).",
    "If currentTheme is missing/invalid, app falls back to the first theme in this file."
  ],
  "themes": [
    {
      "name": "default",
      "description": "DefaultTheme from src/theme/theme.ts. Override only values that intentionally differ.",
      "theme": {}
    },
    {
      "name": "dark",
      "description": "Built-in dark theme optimized for long editing sessions.",
      "baseTheme": "default",
      "theme": {
        "node": {
          "composite": "#5F6368",
          "decorator": "#686D73",
          "action": "#7A6755",
          "condition": "#6E5E74",
          "default": "#5F6368"
        },
        "text": {
          "pinName": "#E5E7EB",
          "variable": "#D1D5DB",
          "constant": "#C7CDD5"
        },
        "edge": {
          "tree": {
            "default": "#9AA3B2",
            "related": "#8FC4E8",
            "hover": "#B9DCF4",
            "selected": "#F3F4F6"
          },
          "data": {
            "default": "#8FA0B4",
            "related": "#73B7E3",
            "hover": "#A8D5F2",
            "selected": "#E5E7EB"
          },
          "fsmTransition": {
            "default": "#9CA3AF",
            "related": "#F2A95A",
            "hover": "#FFC16F",
            "selected": "#F0B56A"
          },
          "defaultState": "#D89A4A",
          "label": {
            "bg": "#20252E",
            "border": "#394150",
            "text": "#F3F4F6"
          }
        },
        "fsmState": {
          "Normal": {
            "bg": "#4F555D",
            "border": "#8B949E"
          },
          "Meta": {
            "bg": "#655574",
            "border": "#9D8BB1"
          },
          "Entry": {
            "bg": "#4B5A5A",
            "border": "#7EA0A0"
          },
          "Exit": {
            "bg": "#6B5555",
            "border": "#AF8D8D"
          },
          "Any": {
            "bg": "#5A4E63",
            "border": "#9D8BB1"
          },
          "Upper": {
            "bg": "#4F555D",
            "border": "#8B949E"
          }
        },
        "comment": {
          "bg": "#2B303A",
          "border": "#4A5568",
          "text": "#E5E7EB"
        },
        "handle": {
          "bg": "#8B949E",
          "hoverBg": "#F3F4F6"
        },
        "ui": {
          "background": "#1D2128",
          "panelBg": "#252A33",
          "border": "#3B4352",
          "textMain": "#F3F4F6",
          "textDim": "#A5B0BF",
          "inputBg": "#1B2028",
          "gridDots": "#2E3543",
          "accent": "#6B7280",
          "accentSoft": "#374151",
          "nodeSelection": "#F3F4F6",
          "nodeSelectionGap": "#1D2128",
          "buttonBg": "#323846",
          "buttonHoverBg": "#3A4252",
          "inspectorRootBg": "#181C23",
          "inspectorContentBg": "#252A33",
          "inspectorHeaderBg": "#303743",
          "inspectorHeaderBorder": "#4B5565",
          "inspectorRowAltBg": "#292F39",
          "inspectorRowHoverBg": "#343D4A",
          "inspectorSeparator": "#3B4352",
          "inspectorInputBorder": "#596475",
          "tabBarBg": "#232833",
          "tabActiveBg": "#3A4353",
          "tabInactiveBg": "#232833",
          "tabActiveText": "#F9FAFB",
          "tabInactiveText": "#9CA3AF",
          "tabBorder": "#3B4352",
          "splitterHover": "#6B7280",
          "terminalBg": "#0F1117",
          "terminalText": "#E5E7EB",
          "terminalHeaderBg": "#1A1F29",
          "terminalInputBg": "#151A22",
          "terminalBorder": "#333B4A",
          "terminalButtonBg": "#2F3745",
          "terminalButtonText": "#F9FAFB",
          "terminalTimestamp": "#9CA3AF",
          "terminalLogInfo": "#E5E7EB",
          "terminalLogSuccess": "#86EFAC",
          "terminalLogWarn": "#FCD34D",
          "terminalLogError": "#FCA5A5",
          "terminalLogPurple": "#C4B5FD",
          "terminalLogOrange": "#FDBA74",
          "terminalLogDim": "#CBD5E1",
          "success": "#4FA56B",
          "danger": "#D66A6A",
          "warning": "#C89A4C"
        }
      }
    },
    {
      "name": "high-contrast-debug",
      "description": "Example override theme: only debug colors are customized.",
      "baseTheme": "default",
      "theme": {
        "debug": {
          "success": {
            "border": "#22C55E",
            "glow": "0 0 12px rgba(34, 197, 94, 0.75)",
            "edge": "#16A34A"
          },
          "failure": {
            "border": "#3B82F6",
            "glow": "0 0 12px rgba(59, 130, 246, 0.75)",
            "edge": "#2563EB"
          },
          "running": {
            "border": "#EC4899",
            "glow": "0 0 12px rgba(236, 72, 153, 0.75)",
            "edge": "#DB2777"
          },
          "break": {
            "border": "#EF4444",
            "glow": "0 0 12px rgba(239, 68, 68, 0.8)",
            "edge": "#DC2626"
          }
        }
      }
    }
  ]
}
